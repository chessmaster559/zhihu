#pragma once
#include <stddef.h>

// Freestanding host shim: only short-string operations used by PetController.
// State tests exercise the real controller, not standard-library allocation.
namespace std {
class string {
public:
    string() { data_[0] = 0; }
    string(const char* text) { assign(text); }
    string(const string& other) { assign(other.c_str()); }
    string& operator=(const string& other) { assign(other.c_str()); return *this; }
    bool empty() const { return length_ == 0; }
    size_t size() const { return length_; }
    void clear() { length_ = 0; data_[0] = 0; }
    const char* c_str() const { return data_; }
    const char* begin() const { return data_; }
    const char* end() const { return data_ + length_; }
private:
    void assign(const char* text) {
        length_ = 0;
        while (text[length_] && length_ < sizeof(data_) - 1) {
            data_[length_] = text[length_];
            ++length_;
        }
        data_[length_] = 0;
    }
    char data_[128];
    size_t length_ = 0;
};
}
